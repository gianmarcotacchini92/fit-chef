# Paid AI is DISABLED by default. Editorial recipes need no API key.
# Enable only after reviewing provider costs/privacy and using the explicit consent UI.
# Never put a secret in NEXT_PUBLIC_* variables; copy this file to .env.local.
FIT_ENABLE_AI=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Firebase browser configuration is public; access is protected by Authentication
# and Firestore owner-only rules, not by hiding the web API key.
# Omit these overrides to use the configured FIT Chef app in sincro-ai.
# Set all six values to connect a different Firebase project.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Online static build only (GitHub Pages). No paid AI keys or API server shipped.
NEXT_PUBLIC_FIT_STATIC=false
NEXT_PUBLIC_BASE_PATH=

# Local MVP: bind Next to 127.0.0.1. API rejects remote hosts and cross-origin writes.
# Do NOT expose via a public proxy/tunnel. Add real server authentication, durable
# distributed quotas and authorized storage before any remote/production deployment.
# The opaque session cookie is only local request/plan isolation, NOT authentication.
# Plans expire after 30 minutes or server restart; regenerate to request an AI image.
# Images persist in .data/images (max 128 files / 256 MiB); back up or remove manually.
# Image URLs are unlisted random local URLs, not authenticated cloud objects.
# Cloud sync preserves image references, not image files. Other installations
# need their own generated images; missing local files should use the UI fallback.
# In-memory per-session/global AI budgets reset on process restart.
